NEXT_PUBLIC_SITE_URL=https://globalpilot.attodigitalhk.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@globalpilot.attodigitalhk.com

# Umami website for GlobalPilot.
NEXT_PUBLIC_UMAMI_SCRIPT_URL=https://analytics.globalpilot.attodigitalhk.com/script.js
NEXT_PUBLIC_UMAMI_WEBSITE_ID=

# GlobalPilot app container.
APP_BIND=127.0.0.1
APP_PORT=3000

# Mac mini Ollama via Tailscale/MagicDNS.
OLLAMA_BASE_URL=http://100.x.x.x:11434
OLLAMA_MODEL=qwen3:8b
OLLAMA_AUTH_TOKEN=
CF_ACCESS_CLIENT_ID=
CF_ACCESS_CLIENT_SECRET=

# Chat-to-Telegram sync.
REQUIRE_TELEGRAM_SYNC=true
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Optional internal/public health checks.
PUBLIC_HEALTH_URL=https://globalpilot.attodigitalhk.com/api/health
